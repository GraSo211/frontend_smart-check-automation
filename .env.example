# Variables de entorno del frontend. Las NEXT_PUBLIC_* se inlinean en el build:
# si cambian, hay que reiniciar `pnpm dev` o generar un nuevo build/deploy.
NEXT_PUBLIC_API_URL=https://backend-smart-check-automation-go.onrender.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<tu-google-client-id>

# Base pública de MediaMTX sin path final. Si no hay un proxy delante,
# incluí el puerto WHEP (por defecto 8889). El front arma la URL WHEP de cada
# dispositivo como <base>/<slug(nombre)>-<entrada|salida>/whep.
# Ejemplos: https://mediamtx.example.com  |  https://mediamtx.example.com:8889
NEXT_PUBLIC_MEDIAMTX_URL=https://mediamtx.example.com
